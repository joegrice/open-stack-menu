<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openstackmenu.OpenStackMenu</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Applications/OpenStackMenu.app/Contents/MacOS/OpenStackMenu</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.xpc.activity</key>
		<dict>
			<key>com.openstackmenu.OpenStackMenu.watchdog</key>
			<dict>
				<key>Interval</key>
				<integer>300</integer>
				<key>GracePeriod</key>
				<integer>60</integer>
				<key>Repeating</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<key>StandardOutPath</key>
	<string>/tmp/com.openstackmenu.OpenStackMenu.stdout.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/com.openstackmenu.OpenStackMenu.stderr.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
